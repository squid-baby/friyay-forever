# PlatformIO build artifacts
.pio/

# IDE settings
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Compiled binaries — OTA ships firmware.bin from GitHub Releases, not from the repo
*.elf
*.map
firmware.bin

# Generated at build time from FIRMWARE_VERSION (see scripts/gen_version_json.py).
# Uploaded as a GitHub Release asset alongside firmware.bin; not a source file.
version.json

# macOS files
.DS_Store
.AppleDouble
.LSOverride
._*

# Backup files
*.bak
*.swp
*~

# Log files
*.log

# Temporary files
*.tmp
*.temp

# Python bytecode (from PlatformIO)
__pycache__/
*.py[cod]

# Local environment files (never commit secrets!)
.env
.env.local
src/secrets.h
secrets.h

# Claude settings (local only)
.claude/
